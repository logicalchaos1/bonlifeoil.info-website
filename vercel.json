{
  "rewrites": [
    { "source": "/suministros", "destination": "/suministros/index.html" },
    { "source": "/suministros/:categoria", "destination": "/suministros/:categoria/index.html" },
    { "source": "/suministros/:categoria/:producto", "destination": "/suministros/:categoria/:producto/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
